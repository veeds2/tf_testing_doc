{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "TestFactors",
  "description": "Friendly HR user guides for TestFactors — AI-powered testing for HR systems (SAP SuccessFactors Employee Central).",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1E40AF"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "mailto:support@testfactors.com"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Core Workflow",
        "icon": "layers",
        "expanded": true,
        "pages": [
          "platform/quickstart",
          "platform/workbooks",
          "platform/scenarios-and-categories",
          "platform/test-cases",
          "platform/test-scripts",
          "platform/test-execution",
          "platform/defects"
        ]
      },
      {
        "group": "Knowledge & AI",
        "icon": "brain-circuit",
        "expanded": true,
        "pages": [
          "knowledge-ai/factorbot",
          "knowledge-ai/knowledge-wiki"
        ]
      },
      {
        "group": "Admin",
        "icon": "shield-check",
        "expanded": true,
        "pages": [
          "admin/memberships-and-access",
          "admin/settings"
        ]
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://auth.testfactors.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://testfactors.com"
    }
  },
  "search": {
    "prompt": "Search the user guide..."
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  }
}
